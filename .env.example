# .env.example -- variable NAMES only. Copy to .env and fill in on a new machine.
# .env is git-ignored and is never committed. See docs/TRACK.md section 7.
# Regenerate: python tools/make_env_example.py

# console.anthropic.com -> API keys (document reader)
ANTHROPIC_API_KEY=enter_your_key_here

# fred.stlouisfed.org -> My Account -> API Keys (macro panel)
FRED_API_KEY=enter_your_key_here

# issued by the provider named in the code that reads it
SEC_CONTACT=enter_your_key_here
